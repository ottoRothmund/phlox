# Optional. Raises GitHub REST API rate limits for server-side search.
GITHUB_TOKEN=

# Shared Phlox reactions, reviews, and discovered topics.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret used to authorize writes to the shared engagement tables.
# Generate with a strong random value (never commit it) and provide only to the
# Next.js server. The Supabase RPCs require it via p_secret; anonymous clients
# cannot call the write functions without it.
SUPABASE_WRITE_TOKEN=

# Sign-in uses Supabase Auth with the GitHub and Google providers. Enable both
# in the Supabase dashboard under Authentication > Providers, and add
# <site-origin>/api/auth/callback to the allowed redirect URLs. No extra keys
# are needed here; SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY above are reused.
